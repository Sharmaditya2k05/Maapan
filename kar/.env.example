# ---------- kar (कर) — tax service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=7003                          # Cloud Run injects PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://taraju:taraju@localhost:5432/taraju_kar?sslmode=disable
AUTO_MIGRATE=true
REDIS_URL=                         # optional: redis://localhost:6379/0 adds a Redis GSTIN cache in front of Postgres

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret
CORS_ORIGINS=http://localhost:3000

EVENTS_DRIVER=direct               # subscribes pehchaan.tenant.created, aadesh.invoice.created, aadesh.note.created;
                                   # publishes kar.einvoice.generated, kar.eway.generated (outbox)
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# ---------- GSP: e-Invoice (IRP), e-Way bill (NIC), GSTN search, GSTR-2B ----------
#   simulator → offline, deterministic, state kept in kar's DB. Default outside prod and
#               REFUSED in prod: nothing it issues is registered with the government.
#   http      → a GST Suvidha Provider contract (Masters India / ClearTax / Cygnet / IRIS …).
#               The paths and header names below are placeholders modelled on the NIC API:
#               VERIFY EVERY ONE AGAINST YOUR GSP'S SANDBOX before going live.
GSP_PROVIDER=simulator
GSP_SIM_KEY=                       # optional HS256 key for simulated signed QR codes (default: derived from SERVICE_SECRET)
GSP_BASE_URL=                      # e.g. https://sandbox.your-gsp.com
GSP_CLIENT_ID=                     # OAuth2 client-credentials (token cached until expiry)
GSP_CLIENT_SECRET=
GSP_TOKEN_PATH=/oauth/token
GSP_TIMEOUT=15s
GSP_SEARCH_PATH=/commonapi/v1.1/search?action=TP&gstin=%s
GSP_IRN_PATH=/eicore/v1.03/Invoice
GSP_IRN_CANCEL_PATH=/eicore/v1.03/Invoice/Cancel
GSP_IRN_BY_DOC_PATH=/eicore/v1.03/Invoice/irnbydocdetails?doctype=%s&docnum=%s&docdate=%s
GSP_EWB_BY_IRN_PATH=/eiewb/v1.03/ewaybill
GSP_EWB_PATH=/ewaybillapi/v1.03/ewayapi?action=GENEWAYBILL
GSP_EWB_PARTB_PATH=/ewaybillapi/v1.03/ewayapi?action=VEHEWB
GSP_EWB_EXTEND_PATH=/ewaybillapi/v1.03/ewayapi?action=EXTENDVALIDITY
GSP_EWB_CANCEL_PATH=/ewaybillapi/v1.03/ewayapi?action=CANEWB
GSP_EWB_GET_PATH=/ewaybillapi/v1.03/ewayapi/GetEwayBill?ewbNo=%s
GSP_GSTR2B_PATH=/gstr2b/v1/get?gstin=%s&rtnprd=%s
GSP_HEADER_GSTIN=gstin             # per-GSTIN API user headers (names vary by GSP)
GSP_HEADER_USERNAME=user_name
GSP_HEADER_PASSWORD=password
EINVOICE_MAX_ATTEMPTS=5            # transient failures retried this often before an auto e-invoice is marked failed

# Per-GSTIN portal API users (PUT /v1/settings/gsp-credentials/{gstin}) are sealed with
# AES-256-GCM under this key: 64 hex chars or base64 of 32 bytes. Required in prod; locally an
# empty value derives a key from SERVICE_SECRET (with a warning). Generate: openssl rand -hex 32
CREDENTIALS_KEY=

# GSTIN verification
#   checksum → offline: checksum + state code only; source "checksum_only", portal_verified=false
#   gsp      → live taxpayer search through the GSP_PROVIDER client (simulator or http), cached
GSTIN_PROVIDER=checksum
GSTIN_CACHE_TTL=168h               # 7 days

# HSN master import (POST /v1/hsn/import). The master is shared by every tenant, so in prod only
# the tenants listed here may import (ops can always use POST /internal/v1/hsn/import).
# Empty outside prod = any settings:manage user.
HSN_IMPORT_TENANTS=

# Services kar calls
AADESH_URL=http://localhost:7004   # invoices for e-way / e-invoice / returns
PEHCHAAN_URL=http://localhost:7001 # store + tenant (seller details)
BAHI_URL=http://localhost:7002     # party address / PIN code
