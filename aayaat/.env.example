# ---------- aayaat (आयात) — import / migration service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=7007                          # Cloud Run injects PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://taraju:taraju@localhost:5432/taraju_aayaat?sslmode=disable
AUTO_MIGRATE=true

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret
CORS_ORIGINS=http://localhost:3000

# Events: aayaat publishes aayaat.import.completed (outbox)
EVENTS_DRIVER=direct               # direct (local) | pubsub (Cloud Run) | log
GCP_PROJECT=                       # required for pubsub and for the Cloud Run Job worker
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# Where uploaded files are kept
STORAGE_DRIVER=local               # local | gcs
STORAGE_DIR=./data/uploads         # local driver
GCS_BUCKET=                        # gcs driver, e.g. taraju-dev-files

# Large imports: above LARGE_IMPORT_ROWS valid rows, commit runs in the
# aayaat-worker Cloud Run Job instead of inside the API instance.
LARGE_IMPORT_ROWS=50000
WORKER_JOB_NAME=                   # e.g. aayaat-worker (empty = always in-process)
GCP_REGION=asia-south1

# Targets of the bulk pushes
BAHI_URL=http://localhost:7002     # parties, opening balances
BHANDAR_URL=http://localhost:7008  # items, opening stock

# Event subscribers (EVENTS_DRIVER=direct only)
SOOCHNA_URL=http://localhost:7006
