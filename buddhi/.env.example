# ---------- buddhi (बुद्धि) — AI initiative service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

# local | dev | staging | prod
APP_ENV=local
# Cloud Run injects PORT=8080
PORT=7010
LOG_LEVEL=info

# Postgres (sanchalan/docker-compose.yml starts it on 5432)
DATABASE_URL=postgres://taraju:taraju@localhost:5432/taraju_buddhi?sslmode=disable
AUTO_MIGRATE=true

# Redis for live dashboard counters. Leave empty to serve dashboards from Postgres only.
REDIS_URL=redis://localhost:6379/3

# Shared secrets — identical in every service. Secret Manager in cloud.
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret

CORS_ORIGINS=http://localhost:3000

# Events: direct (local) | pubsub (Cloud Run) | log
EVENTS_DRIVER=direct
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# ---------- Claude ----------
# Empty = AI endpoints answer 503; dashboards, forecasts and anomaly checks keep working.
ANTHROPIC_API_KEY=
# ask-your-books, weekly summary
AI_MODEL_SMART=claude-opus-5-5
# bill scanning; try claude-haiku-5-5 to cut cost once quality is measured
AI_MODEL_FAST=claude-opus-5-5
# server-side fallback when a request is declined
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT=3m
# per tenant per month (0 = unlimited); tenant_settings can override
AI_MONTHLY_TOKEN_BUDGET=2000000
# AI only for tenants with ai_enabled (pilot flag)
AI_REQUIRE_TENANT_FLAG=true

# ---------- Forecasting ----------
FORECAST_HISTORY_DAYS=56
# supplier lead time
FORECAST_LEAD_DAYS=7
# stock to cover after delivery
FORECAST_COVER_DAYS=7

# Services buddhi reads from / writes to
BAHI_URL=http://localhost:7002
BHANDAR_URL=http://localhost:7008
AADESH_URL=http://localhost:7004
SOOCHNA_URL=http://localhost:7006
PEHCHAAN_URL=http://localhost:7001
