# ---------- soochna (सूचना) — notification service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local
PORT=7006
LOG_LEVEL=info

DATABASE_URL=postgres://maapan:maapan@localhost:5432/maapan_soochna?sslmode=disable
AUTO_MIGRATE=true

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret
CORS_ORIGINS=http://localhost:3000

EVENTS_DRIVER=direct
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# Services soochna calls
PEHCHAAN_URL=http://localhost:7001   # business name + owner phone for alerts
BAHI_URL=http://localhost:7002       # party e-mail for bills; overdue bills for payment reminders (empty = both off)

# ---- Providers: console (prints to log) | msg91 | gupshup | smtp ----
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console

# MSG91 (SMS, DLT-approved Flow templates). Variables are named: ##otp## ##minutes## ...
MSG91_AUTH_KEY=
MSG91_BASE_URL=https://control.msg91.com
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_INVOICE=
MSG91_TEMPLATE_PAYMENT_RECEIPT=
MSG91_TEMPLATE_PAYMENT_REMINDER=
MSG91_TEMPLATE_LEDGER_STATEMENT=
MSG91_TEMPLATE_STOCK_LOW=
MSG91_TEMPLATE_BATCH_EXPIRING=
MSG91_TEMPLATE_IMPORT_DONE=
MSG91_TEMPLATE_WEEKLY_SUMMARY=
MSG91_TEMPLATE_PROMOTION=

# Gupshup (WhatsApp). Template ids of Meta-approved templates; params are positional
# (order = internal/templates ParamOrder). Without an id, free-form text is sent
# (only delivered inside WhatsApp's 24h session window).
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=                   # your WhatsApp business number, 91XXXXXXXXXX
GUPSHUP_APP_NAME=
GUPSHUP_BASE_URL=https://api.gupshup.io
GUPSHUP_TEMPLATE_OTP=
GUPSHUP_TEMPLATE_INVOICE=
GUPSHUP_TEMPLATE_PAYMENT_RECEIPT=
GUPSHUP_TEMPLATE_PAYMENT_REMINDER=
GUPSHUP_TEMPLATE_LEDGER_STATEMENT=
GUPSHUP_TEMPLATE_STOCK_LOW=
GUPSHUP_TEMPLATE_BATCH_EXPIRING=
GUPSHUP_TEMPLATE_IMPORT_DONE=
GUPSHUP_TEMPLATE_WEEKLY_SUMMARY=
GUPSHUP_TEMPLATE_PROMOTION=

# E-mail (bills and statements with the PDF attached). Any transactional provider
# with SMTP works: Amazon SES, Postmark, SendGrid, ZeptoMail, Brevo. Port 587 =
# STARTTLS (required when a username is set), 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=bills@maapan.in          # verified sender; tenants can override in /v1/settings/messaging
EMAIL_FROM_NAME=Maapan
EMAIL_REPLY_TO=

# Invoice PDF attached to the WhatsApp bill (document message) and the e-mail.
# Must be fetchable by Gupshup/Meta without auth. Placeholders: {tenant_id} {invoice_id} {number}.
# Empty = text-only bill (aadesh has no public PDF endpoint yet).
INVOICE_PDF_URL=
# Lifetime of the signed invoice-PDF links fetched from aadesh (AADESH_URL), seconds
INVOICE_PDF_TTL=86400

# Consent & timing. Promotional messages are held in quiet hours (TRAI: 09:00-21:00 only)
# and, with PROMO_REQUIRES_OPT_IN=true, go only to numbers that opted in.
QUIET_HOURS=21:00-09:00
PROMO_REQUIRES_OPT_IN=true

# Cloud Scheduler calls /internal/v1/jobs/* with an OIDC token only (no secret header).
# Audience = this service's run.app URL; e-mails = the scheduler service account. Empty = secret only.
JOBS_OIDC_AUDIENCE=
JOBS_OIDC_EMAILS=

# Shared token appended to provider callback URLs (delivery reports and inbound
# STOP/START): /v1/webhooks/gupshup?token=...  /v1/webhooks/msg91?token=...
WEBHOOK_TOKEN=local-webhook-token
