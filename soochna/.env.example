# ---------- soochna (सूचना) — notification service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local
PORT=7006
LOG_LEVEL=info

DATABASE_URL=postgres://maapan:maapan@localhost:5432/maapan_soochna?sslmode=disable
AUTO_MIGRATE=true

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret
CORS_ORIGINS=http://localhost:3000

EVENTS_DRIVER=direct
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# Services soochna calls (business name + owner phone for alerts)
PEHCHAAN_URL=http://localhost:7001

# ---- Providers: console (prints to log) | msg91 | gupshup ----
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# MSG91 (SMS, DLT-approved Flow templates). Variables are named: ##otp## ##minutes## ...
MSG91_AUTH_KEY=
MSG91_BASE_URL=https://control.msg91.com
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_INVOICE=
MSG91_TEMPLATE_PAYMENT_RECEIPT=
MSG91_TEMPLATE_LEDGER_STATEMENT=
MSG91_TEMPLATE_STOCK_LOW=
MSG91_TEMPLATE_BATCH_EXPIRING=
MSG91_TEMPLATE_IMPORT_DONE=

# Gupshup (WhatsApp). Template ids of Meta-approved templates; params are positional
# (order = internal/templates ParamOrder). Without an id, free-form text is sent
# (only delivered inside WhatsApp's 24h session window).
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=                   # your WhatsApp business number, 91XXXXXXXXXX
GUPSHUP_APP_NAME=
GUPSHUP_BASE_URL=https://api.gupshup.io
GUPSHUP_TEMPLATE_OTP=
GUPSHUP_TEMPLATE_INVOICE=
GUPSHUP_TEMPLATE_PAYMENT_RECEIPT=
GUPSHUP_TEMPLATE_LEDGER_STATEMENT=
GUPSHUP_TEMPLATE_STOCK_LOW=
GUPSHUP_TEMPLATE_BATCH_EXPIRING=
GUPSHUP_TEMPLATE_IMPORT_DONE=

# Shared token appended to provider delivery-report URLs: /v1/webhooks/gupshup?token=...
WEBHOOK_TOKEN=local-webhook-token
