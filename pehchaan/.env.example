# ---------- pehchaan (पहचान) — identity service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=7001                          # Cloud Run injects PORT=8080
LOG_LEVEL=info

# Postgres + Redis (sanchalan/docker-compose.yml)
DATABASE_URL=postgres://taraju:taraju@localhost:5432/taraju_pehchaan?sslmode=disable
REDIS_URL=redis://localhost:6379/0  # OTPs, rate limits, refresh tokens
AUTO_MIGRATE=true

# Shared secrets — identical in every service. JWT_SECRET also signs OTP hashes.
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret

CORS_ORIGINS=http://localhost:3000

# Local only: every OTP is this value and is printed in the log. Ignored unless APP_ENV=local.
OTP_DEV_FIXED=123456

# Events: direct | pubsub | log
EVENTS_DRIVER=direct
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# Services pehchaan calls
SOOCHNA_URL=http://localhost:7006

# Subscribers of pehchaan.tenant.created (EVENTS_DRIVER=direct only)
BAHI_URL=http://localhost:7002
BHANDAR_URL=http://localhost:7008
KAR_URL=http://localhost:7003
