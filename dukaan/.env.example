# ---------- dukaan (दुकान) — Next.js frontend ----------
# Copy to .env.local for local runs:  cp .env.example .env.local
# NEXT_PUBLIC_* values are baked in at BUILD time (Cloud Build passes them as --build-arg).

# The dwaar gateway, including the /api prefix. Every request goes here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Shown in the footer / support links
NEXT_PUBLIC_APP_ENV=local

# Optional: Sentry browser DSN (error reporting); empty disables
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Landing page contact points (optional; each block hides itself when empty)
NEXT_PUBLIC_SUPPORT_PHONE=          # e.g. +91 98765 43210
NEXT_PUBLIC_SUPPORT_WHATSAPP=       # digits only, e.g. 919876543210 (floating chat button)
