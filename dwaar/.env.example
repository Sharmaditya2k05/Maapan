# ---------- dwaar (द्वार) — API gateway / middleware ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=8000                          # Cloud Run injects PORT=8080
LOG_LEVEL=info

# Shared secrets — must be identical in every service.
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret

# Browser origins allowed to call the API (dukaan)
CORS_ORIGINS=http://localhost:3000

# Redis for rate limits shared by all gateway instances. Empty = in-memory (local only).
REDIS_URL=redis://localhost:6379/0

# Rate limits
RATE_LIMIT_PUBLIC_PER_MIN=20       # per client IP on OTP/refresh/webhook routes
RATE_LIMIT_USER_PER_MIN=600        # per logged-in user on everything else
MAX_BODY_MB=25                     # aayaat Excel uploads are the biggest bodies
UPSTREAM_TIMEOUT=60s               # time to first response byte from a service

# Cloud Run: send a Google ID token to upstreams (X-Serverless-Authorization)
USE_ID_TOKENS=false

# Upstreams. A service with no URL answers 503 through the gateway.
PEHCHAAN_URL=http://localhost:7001
BAHI_URL=http://localhost:7002
KAR_URL=http://localhost:7003
AADESH_URL=http://localhost:7004
LENDEN_URL=http://localhost:7005
SOOCHNA_URL=http://localhost:7006
AAYAAT_URL=http://localhost:7007
BHANDAR_URL=http://localhost:7008
NIRMAAN_URL=http://localhost:7009
BUDDHI_URL=http://localhost:7010
