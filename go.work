// Go workspace for local development and IDEs: one `go build ./...` from any
// service directory resolves github.com/taraju/mool to ../mool through this
// file, and gopls sees every service at once.
//
// Cloud Build and the Dockerfiles never see this file (they build one service
// directory with mool passed in as a build context), and CI runs with
// GOWORK=off so it proves each service still builds on its own.
go 1.25.0

use (
	./aadesh
	./aayaat
	./bahi
	./bhandar
	./buddhi
	./dwaar
	./kar
	./lenden
	./mool
	./nirmaan
	./pehchaan
	./soochna
)
