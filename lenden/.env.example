# ---------- lenden (लेनदेन) — payments service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=7005                          # Cloud Run injects PORT=8080
LOG_LEVEL=info

# Postgres (sanchalan/docker-compose.yml starts it on 5432)
DATABASE_URL=postgres://maapan:maapan@localhost:5432/maapan_lenden?sslmode=disable
AUTO_MIGRATE=true

# Shared secrets — must be identical in every service.
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret

# Encrypts tenants' own gateway keys at rest (AES-256-GCM): 32 bytes as 64 hex chars or base64,
# e.g. `openssl rand -hex 32`. Empty outside prod derives a key from SERVICE_SECRET (with a warning);
# prod refuses to start without it. Rotating it means re-saving every tenant's gateway keys.
CREDENTIALS_KEY=

CORS_ORIGINS=http://localhost:3000

# Default gateway for NEW payment requests: mock (local, no keys) | razorpay | cashfree
# Every gateway whose keys are set below stays enabled, so payments taken on one keep
# refunding/reconciling after you switch the default. A request may also pick one: {"gateway":"cashfree"}.
PAYMENT_GATEWAY=mock
MOCK_UPI_VPA=maapan@mock           # VPA in mock UPI intents
PAYEE_DISPLAY_NAME=Maapan Store    # name shown in the customer's UPI app

# Razorpay (test keys start rzp_test_). Required when PAYMENT_GATEWAY=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # Dashboard → Webhooks → secret

# Cashfree Payments (merchant dashboard → Developers → API keys). Set both to enable.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=            # also verifies Cashfree webhook signatures
CASHFREE_ENV=sandbox               # sandbox | production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_FALLBACK_PHONE=           # Cashfree requires a customer phone; used for walk-in UPI QR bills
CASHFREE_WEBHOOK_MAX_SKEW=10m      # reject webhook deliveries older than this
CASHFREE_BASE_URL=                 # local tests only (ignored in prod)

# Events: direct (local) | pubsub (Cloud Run) | log
EVENTS_DRIVER=direct
GCP_PROJECT=
EVENTS_TRUST_IAM=false
USE_ID_TOKENS=false

# Event subscribers of lenden.payment.* (used only by EVENTS_DRIVER=direct)
BAHI_URL=http://localhost:7002
AADESH_URL=http://localhost:7004
SOOCHNA_URL=http://localhost:7006
BUDDHI_URL=http://localhost:7010
