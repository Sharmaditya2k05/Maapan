# ---------- nirmaan (निर्माण) — manufacturing service ----------
# Copy to .env for local runs:  cp .env.example .env
# On Cloud Run these come from --set-env-vars / Secret Manager (see cloudbuild.yaml).

APP_ENV=local                      # local | dev | staging | prod
PORT=7009                          # Cloud Run injects PORT=8080
LOG_LEVEL=info                     # debug | info | warn | error

# Postgres (sanchalan/docker-compose.yml starts it on 5432)
DATABASE_URL=postgres://maapan:maapan@localhost:5432/maapan_nirmaan?sslmode=disable
AUTO_MIGRATE=true                  # apply migrations/*.up.sql on startup

# Shared secrets — must be identical in every service. Secret Manager in cloud.
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
SERVICE_SECRET=local-dev-service-secret

CORS_ORIGINS=http://localhost:3000

# Events: direct (local, POSTs to <SERVICE>_URL/events) | pubsub (Cloud Run) | log
EVENTS_DRIVER=direct
GCP_PROJECT=                       # required when EVENTS_DRIVER=pubsub
EVENTS_TRUST_IAM=false             # true on Cloud Run
USE_ID_TOKENS=false                # true on Cloud Run (internal calls carry Google ID tokens)

# bhandar: item prices for cost roll-up, stock for availability checks.
# Also the subscriber of nirmaan.production.completed (EVENTS_DRIVER=direct).
BHANDAR_URL=http://localhost:7008
# Other subscriber of nirmaan.production.completed (direct driver)
BAHI_URL=http://localhost:7002
